---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHead from '@/components/common/SectionHead.astro';
import SubsectionHead from '@/components/common/SubsectionHead.astro';
import ItemUpgradeBars from './ItemUpgradeBars.astro';
import { getLocalized } from '@/lib/content';
import { useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);

const items = await getLocalized('items', locale);

const CATEGORY_KEY = {
  weapons: 'items.cat.weapons',
  tools: 'items.cat.tools',
  sailing: 'items.cat.sailing',
  upgrades: 'items.cat.upgrades',
} as const;
const categories = ['weapons', 'tools', 'sailing', 'upgrades'] as const;
---
<BaseLayout title={`${t('items.title')} · ${t('site.name')}`} lang={locale}>
  <main id="main" class="mx-auto max-w-4xl px-5 py-14">
    <SectionHead level="h1" title={t('items.title')} note={t('items.note')} />

    {categories.map((cat) => {
      const rows = items.filter((w) => w.data.category === cat).sort((a, b) => Number(b.data.essential) - Number(a.data.essential));
      if (rows.length === 0) return null;
      return (
        <section class="mb-10">
          <SubsectionHead title={t(CATEGORY_KEY[cat])}>
            <span class="h-px flex-1 bg-border"></span>
            <span class="font-mono text-[10px] text-muted-foreground">{rows.length}</span>
          </SubsectionHead>
          <div class="grid gap-3 sm:grid-cols-2">
            {rows.map((w) => (
              <div class="panel p-4" style={w.data.essential ? '--panel-accent: var(--primary)' : undefined}>
                <p class={w.data.essential ? 'font-display font-semibold text-primary' : 'font-display font-semibold text-foreground'}>
                  {w.data.essential ? '★ ' : ''}{w.data.name}
                </p>
                {w.data.notes ? <p class="mt-1 text-xs text-muted-foreground">{w.data.notes}</p> : null}
                <div class="mt-3 border-t border-border/70 pt-2.5">
                  <p class="font-mono text-[10px] uppercase tracking-wide text-muted-foreground">{t('items.location')}</p>
                  <p class="text-xs text-foreground">{w.data.location}{w.data.chapter ? ` · ${w.data.chapter}` : ''}</p>
                </div>
                {w.data.upgradeStages ? (
                  <ItemUpgradeBars stages={w.data.upgradeStages} unit={w.data.upgradeUnit} label={t('items.upgradeProgression')} />
                ) : null}
              </div>
            ))}
          </div>
        </section>
      );
    })}
  </main>
</BaseLayout>
