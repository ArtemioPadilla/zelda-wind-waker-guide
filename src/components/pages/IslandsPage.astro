---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHead from '@/components/common/SectionHead.astro';
import SubsectionHead from '@/components/common/SubsectionHead.astro';
import { getLocalized } from '@/lib/content';
import { useTranslations, localizedHref } from '@/i18n/utils';
import { PILL_STYLE, type PillType } from '@/lib/pills';
import type { Locale } from '@/i18n/ui';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);

const islands = (await getLocalized('islands', locale)).sort((a, b) => a.data.order - b.data.order);
const atlas = (await getLocalized('atlas', locale)).sort((a, b) => a.data.sector.localeCompare(b.data.sector));
const acts = ['despertar', 'travesia', 'final'] as const;
const ACT_KEY = { despertar: 'islands.act.despertar', travesia: 'islands.act.travesia', final: 'islands.act.final' } as const;
const ACT_COLOR = { despertar: 'oklch(0.65 0.14 145)', travesia: 'oklch(0.62 0.12 220)', final: 'oklch(0.55 0.19 27)' } as const;
---
<BaseLayout title={`${t('islands.title')} · ${t('site.name')}`} lang={locale}>
  <main id="main" class="mx-auto max-w-4xl px-5 py-14">
    <SectionHead level="h1" title={t('islands.title')} note={t('islands.note')} class="mb-8" />

    {acts.map((act) => (
      <section class="mb-8">
        <div class="mb-3 flex items-center gap-3">
          <span class="h-[3px] w-6 rounded-full" style={`background:${ACT_COLOR[act]}`}></span>
          <h2 class="font-display text-base font-semibold text-foreground">{t(ACT_KEY[act])}</h2>
        </div>
        <div class="space-y-2">
          {islands.filter((c) => c.data.act === act).map((c) => (
            <a
              href={localizedHref(locale, `/islands/${c.id}/`)}
              data-interactive
              class="panel flex flex-wrap items-center gap-2 px-4 py-3"
              style={`--panel-accent:${ACT_COLOR[act]}`}
            >
              <span class="font-display text-sm font-bold text-primary">{c.data.number}</span>
              <span class="text-sm text-foreground">{c.data.title}</span>
              <span class="ml-auto flex flex-wrap gap-1.5">
                {c.data.pills.map((p: { type: PillType; label: string }) => (
                  <span class={`rounded-full border px-2 py-0.5 font-mono text-[10px] uppercase tracking-wide ${PILL_STYLE[p.type]}`}>{p.label}</span>
                ))}
              </span>
            </a>
          ))}
        </div>
      </section>
    ))}

    <section class="mt-10">
      <SubsectionHead title={t('islands.atlasTitle')} />
      <p class="mb-4 text-sm text-muted-foreground">{t('islands.atlasNote')}</p>
      <div class="ledger overflow-x-auto">
        <table class="w-full min-w-[480px] text-sm">
          <thead class="sr-only">
            <tr>
              <th scope="col">{t('islands.atlasSector')}</th>
              <th scope="col">{t('islands.atlasName')}</th>
              <th scope="col">{t('islands.atlasWhat')}</th>
            </tr>
          </thead>
          <tbody>
            {atlas.map((a) => (
              <tr class="border-b border-border/70 last:border-0">
                <td class="whitespace-nowrap p-3 align-top font-mono text-xs text-primary">{a.data.sector}</td>
                <td class="p-3 align-top font-medium text-foreground">{a.data.name}</td>
                <td class="p-3 align-top text-xs text-muted-foreground">{a.data.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </main>
</BaseLayout>
