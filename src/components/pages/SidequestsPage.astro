---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHead from '@/components/common/SectionHead.astro';
import SubsectionHead from '@/components/common/SubsectionHead.astro';
import { getLocalized } from '@/lib/content';
import { useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);

const cards = (await getLocalized('sidequests', locale)).sort((a, b) => a.data.order - b.data.order);
const labyrinthFloors = (await getLocalized('labyrinth-floors', locale)).sort((a, b) => a.data.floor - b.data.floor);
---
<BaseLayout title={`${t('sidequests.title')} · ${t('site.name')}`} lang={locale}>
  <main id="main" class="mx-auto max-w-4xl px-5 py-14">
    <SectionHead level="h1" title={t('sidequests.title')} class="mb-8" />
    <div class="grid gap-4 sm:grid-cols-2">
      {cards.map((card) => (
        <div class="panel p-4">
          <h2 class="mb-2 font-display text-sm font-semibold text-foreground">{card.data.title}</h2>
          <ul class="list-disc space-y-1.5 pl-4 text-sm text-muted-foreground marker:text-primary/70">
            {card.data.items.map((item: string) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>

    <section class="mt-10">
      <SubsectionHead title={t('sidequests.labyrinthFloorsTitle')} />
      <p class="mb-4 text-sm text-muted-foreground">{t('sidequests.labyrinthFloorsNote')}</p>
      <div class="ledger overflow-x-auto">
        <table class="w-full min-w-[560px] text-sm">
          <thead class="sr-only">
            <tr>
              <th scope="col">{t('sidequests.labyrinthFloor')}</th>
              <th scope="col">{t('sidequests.labyrinthEnemies')}</th>
              <th scope="col">{t('sidequests.labyrinthNotes')}</th>
            </tr>
          </thead>
          <tbody>
            {labyrinthFloors.map((f) => (
              <tr class="border-b border-border/70 last:border-0">
                <td class="w-16 whitespace-nowrap p-3 align-top font-mono text-xs text-primary">
                  {f.data.floor}
                  {f.data.rest && <span class="ml-1 text-[10px] uppercase tracking-wide text-muted-foreground">({t('sidequests.labyrinthRest')})</span>}
                </td>
                <td class="p-3 align-top font-medium text-foreground">{f.data.enemies}</td>
                <td class="p-3 align-top text-xs text-muted-foreground">
                  {f.data.note}
                  <span class="mt-1 block font-mono text-[10px] uppercase tracking-wide text-primary/70">{f.data.block}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </main>
</BaseLayout>
