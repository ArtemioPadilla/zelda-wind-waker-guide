---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHead from '@/components/common/SectionHead.astro';
import ErrorBoundary from '@/components/islands/ErrorBoundary';
import HeartPieceChecklist from '@/components/islands/HeartPieceChecklist';
import { getLocalized } from '@/lib/content';
import { useTranslations } from '@/i18n/utils';
import { sectorToPercent } from '@/lib/greatSeaGrid';
import type { Locale } from '@/i18n/ui';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);

const heartPieces = (await getLocalized('heart-pieces', locale))
  .sort((a, b) => a.data.number - b.data.number)
  .map((m) => ({
    id: m.id,
    number: m.data.number,
    island: m.data.island,
    location: m.data.location,
    note: m.data.note,
    x: m.data.x,
    y: m.data.y,
  }));

// Decorative context dots for the map view — every Great Sea island, not
// just the ones holding a Piece of Heart, so the map reads as "the sea" and
// not just a scatter of unlabeled pins. Positions come from the same
// sector -> percent math the heart-pieces x/y fields were generated from.
const atlasDots = (await getLocalized('atlas', locale)).map((a) => ({
  ...sectorToPercent(a.data.sector),
  name: a.data.name,
}));
---
<BaseLayout title={`${t('heartPieces.title')} · ${t('site.name')}`} lang={locale}>
  <main id="main" class="mx-auto max-w-4xl px-5 py-14">
    <SectionHead level="h1" title={t('heartPieces.title')} tight />
    <p class="mb-6 text-sm text-muted-foreground">{t('heartPieces.note')}</p>
    <ErrorBoundary client:load name="HeartPieceChecklist" messageLabel={t('a11y.errorBoundaryMessage')} reportLabel={t('a11y.errorBoundaryReport')}>
      <HeartPieceChecklist
        client:load
        items={heartPieces}
        progressLabel={t('heartPieces.progress')}
        atlasDots={atlasDots}
        viewListLabel={t('heartPieces.viewList')}
        viewMapLabel={t('heartPieces.viewMap')}
        mapLabel={t('heartPieces.mapLabel')}
        mapCheckedLabel={t('heartPieces.mapChecked')}
        mapUncheckedLabel={t('heartPieces.mapUnchecked')}
        mapMissingNote={t('heartPieces.mapMissingNote')}
        mapCreditLabel={t('heartPieces.mapCredit')}
      />
    </ErrorBoundary>
  </main>
</BaseLayout>
