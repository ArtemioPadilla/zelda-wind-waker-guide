---
// Compact visual comparison for a numeric upgrade progression (Quiver+,
// Bomb Bag+, Wallet+ — the only `items` entries with a genuine multi-stage
// before/after, per itemsSchema's `upgradeStages`). Renders one bar per
// stage, each filled relative to the final (max) stage, so the delta between
// tiers reads at a glance instead of as a flat "30 → 60 → 99" string. Static
// markup only — no client JS, matching this table's "lightweight polish
// pass" scope.
interface Props {
  stages: number[];
  unit?: string;
  label: string;
}
const { stages, unit, label } = Astro.props;
const max = stages[stages.length - 1];
---
<div class="mt-3 border-t border-border/70 pt-2.5">
  <p class="font-mono text-[10px] uppercase tracking-wide text-muted-foreground">{label}</p>
  <div class="mt-1.5 space-y-1">
    {stages.map((value, i) => (
      <div class="flex items-center gap-2">
        <div class="h-2 flex-1 overflow-hidden rounded-full border border-border bg-muted">
          <div
            class={`h-full rounded-full ${i === stages.length - 1 ? 'bg-primary' : 'bg-primary/45'}`}
            style={`width:${Math.max((value / max) * 100, 4)}%`}
          ></div>
        </div>
        <span class={`w-16 shrink-0 text-right font-mono text-xs ${i === stages.length - 1 ? 'font-bold text-primary' : 'text-muted-foreground'}`}>
          {value}{unit ? ` ${unit}` : ''}
        </span>
      </div>
    ))}
  </div>
</div>
